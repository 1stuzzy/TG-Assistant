# Получите на https://my.telegram.org -> API development tools
TG_API_ID=your_api_id
TG_API_HASH=your_api_hash

# Пути хранения данных (можно оставить по умолчанию)
SESSIONS_DIR=../data/sessions
ACCOUNTS_FILE=../data/accounts.json
CHARACTERS_FILE=../data/characters.json
WORKERS_FILE=../data/workers.json
MODELS_DIR=../data/models
# Правила живого диалога: human_rules, emotions, topics, dialogues
CONVERSATION_PACK_DIR=../data/rules
RENTAL_DB=../data/rental.db

# CPU-инференс: 0 = все ядра. 8B держит 4096; не ставь ниже длины промта.
LLM_N_CTX=4096
# compact — короткая система без 18 примеров в контексте. full — старый длинный промт.
LLM_PROMPT_MODE=compact
# Пар из dialogues.jsonl в каждый запрос. 0 = стиль не через few-shot (нужен compact или LoRA).
LLM_FEW_SHOTS=6
LLM_N_THREADS=0
LLM_N_GPU_LAYERS=0
LLM_MAX_TOKENS=160
# Сэмплеры против штампов ассистента (llama.cpp / llama-server)
LLM_TEMPERATURE=0.82
LLM_TOP_P=1.0
LLM_MIN_P=0.05
LLM_REPEAT_PENALTY=1.08
LLM_DRY_MULTIPLIER=0.8
LLM_DRY_BASE=1.75
LLM_DRY_ALLOWED_LENGTH=2
# XTC по умолчанию выкл — на короткой личке ломает фразы
LLM_XTC_PROBABILITY=0
LLM_XTC_THRESHOLD=0.1
# Самой написать, если в уже идущем чате зависла тишина (минуты)
LLM_NUDGE=1
LLM_NUDGE_AFTER_MIN=12
LLM_NUDGE_SECOND_MIN=90
# Сколько последних сообщений из Telegram подтягивать в ответ (долгая память ещё в chat_memory.json)
CHAT_HISTORY_FETCH=48

# Живой контекст для модели (не обучение весов, а снимок «сейчас»)
# Пояс, если в карточке персонажа нет города
WORLD_TIMEZONE=Europe/Moscow
WORLD_NEWS=1
WORLD_WEATHER=1
WORLD_NEWS_TTL=1200

# Домены, которым разрешено обращаться к API (через запятую)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500

# Вход администратора панели аренды (первый запуск создаёт пользователя)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin
