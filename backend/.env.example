# Получите на https://my.telegram.org -> API development tools
TG_API_ID=your_api_id
TG_API_HASH=your_api_hash

# Пути хранения данных (можно оставить по умолчанию)
SESSIONS_DIR=../data/sessions
ACCOUNTS_FILE=../data/accounts.json
CHARACTERS_FILE=../data/characters.json
WORKERS_FILE=../data/workers.json
MODELS_DIR=../data/models
# Правила живого диалога: human_rules, emotions, topics, dialogues
CONVERSATION_PACK_DIR=../data/rules
RENTAL_DB=../data/rental.db

# CPU-инференс: 0 = все ядра минус одно
LLM_N_CTX=2048
LLM_N_THREADS=0
LLM_N_GPU_LAYERS=0
LLM_MAX_TOKENS=96

# Живой контекст для модели (не обучение весов, а снимок «сейчас»)
# Пояс, если в карточке персонажа нет города
WORLD_TIMEZONE=Europe/Moscow
WORLD_NEWS=1
WORLD_WEATHER=1
WORLD_NEWS_TTL=1200

# Домены, которым разрешено обращаться к API (через запятую)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500

# Вход администратора панели аренды (первый запуск создаёт пользователя)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin
